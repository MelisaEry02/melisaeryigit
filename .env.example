# Oturum imzası — rastgele uzun bir metin olsun
SESSION_SECRET=buraya-uzun-rastgele-bir-metin-yaz

# Admin şifresi (düz metin). Geliştirme için kolay yol.
# .env.local dosyasında kendi şifreni koy; bu dosyayı kopyalayıp kullan.
ADMIN_PASSWORD=degistir-beni

# İsteğe bağlı: bcrypt hash. Doluysa ADMIN_PASSWORD yerine bu kullanılır.
# Örnek üretmek: node -e "console.log(require('bcryptjs').hashSync('sifren',10))"
# ADMIN_PASSWORD_HASH=

# SQLite dosya yolu (isteğe bağlı)
# DATABASE_PATH=./data/site.db
